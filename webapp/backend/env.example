# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rl_chat

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MIN=1440

# CORS (frontend origin); * for demo
CORS_ORIGINS=*

# --- RL agent integration ---
# Absolute path to the existing research project root (the folder that contains `src/`).
# Example (Windows): E:/x/ecommerce-multihop-qa
RESEARCH_PROJECT_PATH=

# Set false to run the web demo WITHOUT loading the heavy RL model / Neo4j.
# In that case /chat returns a clearly-labelled mock answer so the UI is fully usable.
AGENT_ENABLED=false

# --- Connection settings passed through to the RL project (only when AGENT_ENABLED=true) ---
# Leave blank to use the project's own defaults / shell env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
# Needed for the LLM answer synthesiser (final natural-language answer).
ANTHROPIC_API_KEY=
